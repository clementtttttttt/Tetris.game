<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="tetris" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/tetris" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-march=k8" />
					<Add option="-Og" />
					<Add option="-g" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/tetris" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="`sdl2-config --cflags`" />
		</Compiler>
		<Linker>
			<Add option="`sdl2-config --libs`" />
			<Add option="`pkg-config SDL2_mixer --libs`" />
			<Add option="`pkg-config SDL2_ttf --libs`" />
		</Linker>
		<Unit filename="main.cpp" />
		<Unit filename="notes.cpp" />
		<Unit filename="notes.hpp" />
		<Unit filename="game_state.hpp" />
		<Unit filename="tetris.hpp" />
		<Unit filename="st_maingame.cpp" />
		<Unit filename="st_maingame.hpp" />
		<Unit filename="st_titlescreen.cpp" />
		<Unit filename="st_titlescreen.hpp" />
		<Unit filename="sound_effects.cpp" />
		<Unit filename="sound_effects.hpp" />
		<Unit filename="bgm.hpp" />
		<Unit filename="theme.cpp" />
		<Unit filename="theme.hpp" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
